#!/bin/bash
###############################################################################
##                                                                           ##
##                     s  l  u  r  m  .  j  c  f                             ##
##                                                                           ##
##  SLURM JCF file for running an Intel MPI job on the HPC2024 cluster       ##
##  at PIK                                                                   ##
##                                                                           ##
##  Automatically generated by lpjsubmit shell script                        ##
##                                                                           ##
##  Created: 05.06.2026                                                      ##
##                                                                           ##
###############################################################################

#SBATCH --ntasks=128
#SBATCH --qos=short
#SBATCH --signal=15@180
#SBATCH --cpus-per-task=1
#SBATCH -J LPJmL6.0.4
#SBATCH --comment="LPJmL Version 6.0.4 args: -couple $(hostname) /p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/config_coupled_isimip_ssp370_mpi-esm1-2-hr_8.json"
#SBATCH --mail-user=jannesbr
#SBATCH --mail-type=end,fail
#SBATCH --time=12:00:00
#SBATCH --account=copan
#SBATCH --tasks-per-node=128
#SBATCH -o  /p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/output/coupled_isimip_ssp370_mpi-esm1-2-hr_8/stdout_2026-06-05_23-32.log
#SBATCH -e  /p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/output/coupled_isimip_ssp370_mpi-esm1-2-hr_8/stderr_2026-06-05_23-32.log

export LPJROOT=/p/projects/copan/users/jannesbr/repos/lpjml-inseeds

ulimit -c unlimited

module list 2>&1 # show all loaded modules

/p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/output/coupled_isimip_ssp370_mpi-esm1-2-hr_8/copan_lpjml.sh & # start program in background
couple_pid=$! # store PID

mpirun $LPJROOT/bin/lpjml --version

mpirun $LPJROOT/bin/lpjml  -couple $(hostname) /p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/config_coupled_isimip_ssp370_mpi-esm1-2-hr_8.json

rc=$?  # save return code of mpirun

wait $couple_pid # wait for /p/projects/copan/users/jannesbr/projects/inseeds_ca/tests/sims/global_isimip/output/coupled_isimip_ssp370_mpi-esm1-2-hr_8/copan_lpjml.sh to finish

exit $rc # exit with return code
